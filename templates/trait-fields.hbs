<div class="form-group"><label>Name</label><input name="{{prefix}}.label" value="{{trait.label}}"></div>
<div class="form-group"><label>Description</label><textarea name="{{prefix}}.description">{{trait.description}}</textarea></div>
<div class="form-group"><label>Modifier</label><input type="number" name="{{prefix}}.value" value="{{trait.value}}"><label>Type</label><select name="{{prefix}}.type">{{selectOptions modifierTypes selected=trait.type}}</select></div>
